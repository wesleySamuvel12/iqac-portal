// IQAC Enterprise ERP Management System - Database Schema (SQLite)
// Nehru Institute of Engineering and Technology (Autonomous)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== USER & AUTHENTICATION ====================

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  password           String
  name               String
  role               String     @default("STAFF")
  phone              String?
  avatar             String?
  isActive           Boolean    @default(true)
  status             String     @default("ACTIVE")
  mustChangePassword Boolean    @default(false)
  createdBy          String?
  createdByRole      String?
  createdById        String?
  departmentId       String?
  lastLogin          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  
  department    Department? @relation(fields: [departmentId], references: [id])
  faculty       Faculty?
  student       Student[]
  notifications Notification[]
  auditLogs     AuditLog[]
  feedbacks     Feedback[]
  createdFeedbackForms FeedbackForm[]     @relation("FeedbackFormCreator")
  feedbackAssignments  FeedbackAssignment[]
  feedbackResponses    FeedbackResponse[]
  
  @@index([departmentId])
  @@index([role])
  @@index([email])
}

// ==================== DEPARTMENT ====================

model Department {
  id              String   @id @default(cuid())
  name            String   @unique
  code            String   @unique
  description     String?
  vision          String?
  mission         String?
  peo             String?
  po              String?
  pso             String?
  logo            String?
  hodId           String?
  establishedYear Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  users           User[]
  faculty         Faculty[]
  students        Student[]
  batches         Batch[]
  activities      Activity[]
  research        Research[]
  feedbackForms   FeedbackForm[]
  
  @@index([code])
}

// ==================== FACULTY ====================

model Faculty {
  id                String    @id @default(cuid())
  employeeId        String    @unique
  name              String?
  email             String?
  phone             String?
  userId            String?   @unique
  departmentId      String
  designation       String?
  qualification     String?
  specialization    String?
  experience        Float?
  dateOfJoining     DateTime?
  researchArea      String?
  photo             String?
  isHOD             Boolean   @default(false)
  approvalStatus    String    @default("APPROVED")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  department        Department @relation(fields: [departmentId], references: [id])
  activities        FacultyActivity[]
  researchPublications ResearchPublication[]
  certifications    Certification[]
  awards             Award[]
  consultations      Consultancy[]
  patents            Patent[]
  books              Book[]
  projects           Project[]
  fdpPrograms        FDPProgram[]
  advisedBatches     Batch[]
  
  @@index([departmentId])
  @@index([employeeId])
  @@index([userId])
}

// ==================== STUDENT ====================

model Student {
  id                String    @id @default(cuid())
  registerNumber    String    @unique
  rollNumber        String?
  name              String?
  email             String?
  phone             String?
  userId            String?   @unique
  departmentId      String
  batchId           String?
  semester          Int?
  section           String?
  batch             String?
  cgpa              Float?
  admissionYear     Int?
  graduationYear    Int?
  photo             String?
  approvalStatus    String    @default("APPROVED")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  department        Department @relation(fields: [departmentId], references: [id])
  batchInfo         Batch?    @relation(fields: [batchId], references: [id])
  activities        StudentActivity[]
  achievements      StudentAchievement[]
  internships       Internship[]
  placements        Placement[]
  certifications    StudentCertification[]
  npCourses         NPCourse[]
  hackathons        HackathonParticipation[]
  startups          Startup[]
  
  @@index([departmentId])
  @@index([registerNumber])
  @@index([userId])
}

// ==================== ACTIVITY MODULES ====================

model Activity {
  id               String        @id @default(cuid())
  title            String
  type             String
  description      String?
  startDate        DateTime?
  endDate          DateTime?
  venue            String?
  organizer        String?
  participants     Int?
  outcome          String?
  status           String        @default("PLANNED")
  departmentId     String
  conductedBy      String?
  attachments      String?
  reportUrl        String?
  approvalStatus   String        @default("PENDING")
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  
  department       Department     @relation(fields: [departmentId], references: [id])
  facultyActivities FacultyActivity[]
  studentActivities StudentActivity[]
  
  @@index([departmentId])
  @@index([type])
  @@index([status])
  @@index([approvalStatus])
}

model FacultyActivity {
  id          String   @id @default(cuid())
  facultyId   String
  activityId  String
  role        String?
  hoursSpent  Float?
  remarks     String?
  createdAt   DateTime @default(now())
  
  faculty     Faculty  @relation(fields: [facultyId], references: [id])
  activity    Activity @relation(fields: [activityId], references: [id])
  
  @@unique([facultyId, activityId])
}

model StudentActivity {
  id          String   @id @default(cuid())
  studentId   String
  activityId  String
  role        String?
  remarks     String?
  createdAt   DateTime @default(now())
  
  student     Student  @relation(fields: [studentId], references: [id])
  activity    Activity @relation(fields: [activityId], references: [id])
  
  @@unique([studentId, activityId])
}

// ==================== RESEARCH MODULES ====================

model Research {
  id               String         @id @default(cuid())
  title            String
  type             String
  description      String?
  authors          String?
  publication      String?
  publisher        String?
  doi              String?
  isbn             String?
  issn             String?
  volume           String?
  issue            String?
  pages            String?
  publishDate      DateTime?
  indexedIn        String?
  impactFactor     Float?
  citations        Int            @default(0)
  url              String?
  departmentId     String
  facultyId        String?
  status           String         @default("PUBLISHED")
  approvalStatus   String         @default("PENDING")
  approvedBy       String?
  approvedAt       DateTime?
  attachments      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  
  department       Department            @relation(fields: [departmentId], references: [id])
  publications     ResearchPublication[]
  
  @@index([departmentId])
  @@index([type])
  @@index([status])
}

model ResearchPublication {
  id          String   @id @default(cuid())
  researchId  String
  facultyId   String
  authorOrder Int?
  createdAt   DateTime @default(now())
  
  research    Research @relation(fields: [researchId], references: [id])
  faculty     Faculty  @relation(fields: [facultyId], references: [id])
  
  @@unique([researchId, facultyId])
}

// ==================== CERTIFICATION & AWARDS ====================

model Certification {
  id                String   @id @default(cuid())
  title             String
  issuer            String?
  certificateNumber String?
  issuedDate        DateTime?
  validUntil        DateTime?
  credentialUrl     String?
  facultyId         String
  attachments       String?
  approvalStatus    String   @default("PENDING")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  faculty           Faculty  @relation(fields: [facultyId], references: [id])
  
  @@index([facultyId])
}

model StudentCertification {
  id                String   @id @default(cuid())
  title             String
  issuer            String?
  certificateNumber String?
  issuedDate        DateTime?
  validUntil        DateTime?
  credentialUrl     String?
  studentId         String
  attachments       String?
  approvalStatus    String   @default("PENDING")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  student           Student  @relation(fields: [studentId], references: [id])
  
  @@index([studentId])
}

model Award {
  id           String   @id @default(cuid())
  title        String
  awardedBy    String?
  awardDate    DateTime?
  category     String?
  level        String?
  description  String?
  facultyId    String
  attachments  String?
  createdAt    DateTime @default(now())
  
  faculty      Faculty  @relation(fields: [facultyId], references: [id])
  
  @@index([facultyId])
}

model StudentAchievement {
  id            String          @id @default(cuid())
  title         String
  type          String
  description   String?
  achievedDate  DateTime?
  level         String?
  position      String?
  organizedBy   String?
  studentId     String
  attachments   String?
  approvalStatus String         @default("PENDING")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  student       Student          @relation(fields: [studentId], references: [id])
  
  @@index([studentId])
  @@index([type])
}

// ==================== INTERNSHIP & PLACEMENT ====================

model Internship {
  id               String   @id @default(cuid())
  company          String
  location         String?
  domain           String?
  startDate        DateTime?
  endDate          DateTime?
  stipend          Float?
  offerLetter      Boolean  @default(false)
  completionCert   Boolean  @default(false)
  description      String?
  studentId        String
  supervisor       String?
  supervisorEmail  String?
  attachments      String?
  approvalStatus   String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  student          Student  @relation(fields: [studentId], references: [id])
  
  @@index([studentId])
}

model Placement {
  id               String   @id @default(cuid())
  company          String
  location         String?
  designation      String?
  packageLPA       Float?
  offerDate        DateTime?
  joiningDate      DateTime?
  accepted         Boolean  @default(false)
  joined           Boolean  @default(false)
  description      String?
  studentId        String
  attachments      String?
  approvalStatus   String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  student          Student  @relation(fields: [studentId], references: [id])
  
  @@index([studentId])
}

// ==================== NPTEL & ONLINE COURSES ====================

model NPCourse {
  id             String   @id @default(cuid())
  courseName     String
  courseId       String?
  platform       String?
  instructor     String?
  startDate      DateTime?
  endDate        DateTime?
  score          Float?
  grade          String?
  certificateUrl String?
  studentId      String
  attachments    String?
  approvalStatus String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  student        Student  @relation(fields: [studentId], references: [id])
  
  @@index([studentId])
}

// ==================== HACKATHON & STARTUP ====================

model HackathonParticipation {
  id           String   @id @default(cuid())
  name         String
  organizer    String?
  level        String?
  startDate    DateTime?
  endDate      DateTime?
  position     String?
  projectTitle String?
  teamSize     Int?
  description  String?
  studentId    String
  attachments  String?
  approvalStatus String @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
    
  student      Student  @relation(fields: [studentId], references: [id])
  
  @@index([studentId])
}

model Startup {
  id           String   @id @default(cuid())
  name         String
  domain       String?
  founderRole  String?
  foundedDate  DateTime?
  funding      Float?
  stage        String?
  description  String?
  website      String?
  studentId    String
  incubator    String?
  attachments  String?
  approvalStatus String @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  student      Student  @relation(fields: [studentId], references: [id])
  
  @@index([studentId])
}

// ==================== PATENTS & BOOKS ====================

model Patent {
  id           String        @id @default(cuid())
  title        String
  patentNumber String?
  inventors    String?
  filingDate   DateTime?
  publishDate  DateTime?
  grantDate    DateTime?
  status       String        @default("FILED")
  country      String?
  category     String?
  facultyId    String
  attachments  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  faculty      Faculty  @relation(fields: [facultyId], references: [id])
  
  @@index([facultyId])
}

model Book {
  id           String   @id @default(cuid())
  title        String
  authors      String?
  publisher    String?
  isbn         String?
  edition      String?
  publishDate  DateTime?
  bookType     String   @default("TEXTBOOK")
  category     String?
  facultyId    String
  attachments  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  faculty      Faculty  @relation(fields: [facultyId], references: [id])
  
  @@index([facultyId])
}

// ==================== PROJECTS & CONSULTANCY ====================

model Project {
  id                   String        @id @default(cuid())
  title                String
  type                 String        @default("RESEARCH")
  description          String?
  principalInvestigator String?
  coInvestigators      String?
  fundingAgency        String?
  amount               Float?
  startDate            DateTime?
  endDate              DateTime?
  status               String        @default("ONGOING")
  outcomes             String?
  facultyId            String
  attachments          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  
  faculty              Faculty  @relation(fields: [facultyId], references: [id])
  
  @@index([facultyId])
  @@index([type])
  @@index([status])
}

model Consultancy {
  id           String    @id @default(cuid())
  title        String
  client       String?
  amount       Float?
  startDate    DateTime?
  endDate      DateTime?
  status       String    @default("ONGOING")
  description  String?
  facultyId    String
  attachments  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  faculty      Faculty  @relation(fields: [facultyId], references: [id])
  
  @@index([facultyId])
}

// ==================== FDP & TRAINING ====================

model FDPProgram {
  id             String   @id @default(cuid())
  title          String
  organizer      String?
  type           String?
  startDate      DateTime?
  endDate        DateTime?
  durationDays   Int?
  venue          String?
  level          String?
  topics         String?
  facultyId      String
  attachments    String?
  certificateUrl String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  faculty        Faculty  @relation(fields: [facultyId], references: [id])
  
  @@index([facultyId])
}

// ==================== APPROVAL WORKFLOW ====================

model Approval {
  id           String        @id @default(cuid())
  entityType   String
  entityId     String
  requestedBy  String
  currentStage String        @default("STAFF_REVIEW")
  status       String        @default("PENDING")
  reviewedBy   String?
  reviewedAt   DateTime?
  comments     String?
  activityId   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  @@index([entityType, entityId])
  @@index([requestedBy])
  @@index([status])
  @@index([currentStage])
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id          String           @id @default(cuid())
  title       String
  message     String
  type        String           @default("INFO")
  userId      String
  isRead      Boolean          @default(false)
  actionUrl   String?
  relatedId   String?
  entityType  String?
  createdAt   DateTime         @default(now())
  
  user        User             @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ==================== FEEDBACK ====================

model Feedback {
  id          String   @id @default(cuid())
  category    String
  rating      Int
  comments    String?
  anonymous   Boolean  @default(false)
  userId      String
  response    String?
  respondedAt DateTime?
  respondedBy String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([category])
}

// ==================== DOCUMENTS ====================

model Document {
  id            String   @id @default(cuid())
  title         String
  fileName      String
  fileUrl       String
  fileType      String
  fileSize      Int
  uploadedBy    String
  category      String   @default("OTHER")
  entityType    String?
  entityId      String?
  tags          String?
  isPublic      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([uploadedBy])
  @@index([category])
  @@index([entityType, entityId])
}

// ==================== AUDIT LOGS ====================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldValue   String?
  newValue   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// ==================== SYSTEM SETTINGS ====================

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  category    String   @default("GENERAL")
  isPublic    Boolean  @default(false)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([key])
  @@index([category])
}

// ==================== INSTITUTION & ACADEMIC STRUCTURE ====================

model Institution {
  id             String   @id @default(cuid())
  name           String
  code           String   @unique
  address        String?
  email          String?
  phone          String?
  website        String?
  logo           String?
  principalName  String?
  iqacCoordinator String?
  naacGrade      String?
  nbaAccredited  Boolean  @default(false)
  nirfRank       Int?
  establishedYear Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Batch {
  id            String    @id @default(cuid())
  name          String
  academicYear  String
  startYear     Int
  endYear       Int
  departmentId  String
  advisorId     String?
  isCurrent     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  department    Department @relation(fields: [departmentId], references: [id])
  advisor       Faculty?   @relation(fields: [advisorId], references: [id])
  students      Student[]
  
  @@index([departmentId])
  @@index([academicYear])
}

// ==================== CMS MODULE ====================

model CmsConfig {
  id               String   @id @default(cuid())
  collegeName      String   @default("Nehru Institute of Engineering and Technology")
  tagline          String?  @default("Autonomous Institution | Accredited by NAAC with A+ Grade")
  logoUrl          String?
  faviconUrl       String?
  primaryColor     String   @default("#1e3a8a")
  secondaryColor   String   @default("#0f766e")
  accentColor      String   @default("#f59e0b")
  contactEmail     String?
  contactPhone     String?
  address          String?
  facebookUrl      String?
  twitterUrl       String?
  linkedinUrl      String?
  youtubeUrl       String?
  instagramUrl     String?
  footerText       String?  @default("© 2026 Nehru Institute of Engineering and Technology. All rights reserved.")
  heroTitle        String?  @default("Internal Quality Assurance Cell (IQAC)")
  heroSubtitle     String?  @default("Building Excellence in Technical Education & Research")
  heroBgUrl        String?
  statsDepartments Int      @default(8)
  statsFaculty     Int      @default(120)
  statsStudents    Int      @default(2500)
  statsResearch    Int      @default(450)
  updatedBy        String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

model CmsPage {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String?
  status      String   @default("DRAFT")
  metaTitle   String?
  metaDesc    String?
  authorId    String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([status])
}

model CmsMenu {
  id        String    @id @default(cuid())
  title     String
  url       String?
  parentId  String?
  order     Int       @default(0)
  target    String    @default("_self")
  isActive  Boolean   @default(true)
  parent    CmsMenu?  @relation("MenuHierarchy", fields: [parentId], references: [id])
  children  CmsMenu[] @relation("MenuHierarchy")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([parentId])
}

model CmsBanner {
  id          String   @id @default(cuid())
  title       String
  imageUrl    String
  linkUrl     String?
  position    String   @default("HOME_TOP")
  status      String   @default("ACTIVE")
  order       Int      @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([position])
  @@index([status])
}

model CmsAnnouncement {
  id          String    @id @default(cuid())
  title       String
  content     String?
  type        String    @default("INFO")
  linkUrl     String?
  isPinned    Boolean   @default(false)
  status      String    @default("ACTIVE")
  targetAudience String @default("ALL")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

// ==================== AUDIT & BACKUP ====================

model AuditLogEntry {
  id        String   @id @default(cuid())
  actor     String
  action    String
  target    String?
  details   String?
  ip        String?
  timestamp DateTime @default(now())

  @@index([actor])
  @@index([action])
  @@index([timestamp])
}

model SystemBackup {
  id        String   @id @default(cuid())
  filename  String
  path      String
  size      Int
  type      String   @default("FULL")
  status    String   @default("COMPLETED")
  createdBy String?
  createdAt DateTime @default(now())

  @@index([status])
  @@index([type])
}

// ==================== FEEDBACK ENGINE ====================

model FeedbackForm {
  id             String               @id @default(cuid())
  title          String
  description    String?
  targetAudience String               @default("ALL")
  targetRole     String?
  departmentId   String?
  batchId        String?
  academicYear   String?
  semester       Int?
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean              @default(true)
  isAnonymous    Boolean              @default(false)
  creatorId      String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  creator        User                 @relation("FeedbackFormCreator", fields: [creatorId], references: [id])
  department     Department?          @relation(fields: [departmentId], references: [id])
  questions      FeedbackQuestion[]
  assignments    FeedbackAssignment[]
  responses      FeedbackResponse[]

  @@index([creatorId])
  @@index([departmentId])
  @@index([isActive])
}

model FeedbackQuestion {
  id           String           @id @default(cuid())
  formId       String
  questionText String
  questionType String           @default("RATING_1_5")
  options      String?
  isRequired   Boolean          @default(true)
  order        Int              @default(0)
  category     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  form         FeedbackForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers      FeedbackAnswer[]

  @@index([formId])
}

model FeedbackAssignment {
  id           String       @id @default(cuid())
  formId       String
  userId       String?
  role         String?
  departmentId String?
  isCompleted  Boolean      @default(false)
  completedAt  DateTime?
  createdAt    DateTime     @default(now())

  form         FeedbackForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([userId])
}

model FeedbackResponse {
  id           String           @id @default(cuid())
  formId       String
  userId       String?
  submittedAt  DateTime         @default(now())
  comments     String?

  form         FeedbackForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers      FeedbackAnswer[]

  @@index([formId])
  @@index([userId])
}

model FeedbackAnswer {
  id          String           @id @default(cuid())
  responseId  String
  questionId  String
  ratingValue Int?
  textValue   String?
  optionsValue String?

  response    FeedbackResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question    FeedbackQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([questionId])
}
