// IQAC Enterprise ERP Management System - Complete Database Schema
// Nehru Institute of Engineering and Technology (Autonomous)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== USER & AUTHENTICATION ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  role          UserRole  @default(STAFF)
  phone         String?
  avatar        String?
  isActive      Boolean   @default(true)
  departmentId  String?
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  department    Department? @relation(fields: [departmentId], references: [id])
  faculty       Faculty?
  student       Student[]
  notifications Notification[]
  auditLogs     AuditLog[]
  feedbacks     Feedback[]
  createdFeedbackForms FeedbackForm[]     @relation("FeedbackFormCreator")
  feedbackAssignments  FeedbackAssignment[]
  feedbackResponses    FeedbackResponse[]
  
  @@index([departmentId])
  @@index([role])
  @@index([email])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  HOD
  STAFF
  STUDENT
}

// ==================== DEPARTMENT ====================

model Department {
  id              String   @id @default(cuid())
  name            String   @unique
  code            String   @unique
  description     String?
  vision          String?
  mission         String?
  peo             String?
  po              String?
  pso             String?
  logo            String?
  hodId           String?
  establishedYear Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  users           User[]
  faculty         Faculty[]
  students        Student[]
  batches         Batch[]
  activities      Activity[]
  research        Research[]
  feedbackForms   FeedbackForm[]
  
  @@index([code])
}

// ==================== FACULTY ====================

model Faculty {
  id                String    @id @default(cuid())
  employeeId        String    @unique
  userId            String    @unique
  departmentId      String
  designation       String?
  qualification     String?
  specialization    String?
  experience        Float?
  dateOfJoining     DateTime?
  researchArea      String?
  photo             String?
  isHOD             Boolean   @default(false)
  approvalStatus    ApprovalStatus @default(APPROVED)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  user              User      @relation(fields: [userId], references: [id])
  department        Department @relation(fields: [departmentId], references: [id])
  activities        FacultyActivity[]
  researchPublications ResearchPublication[]
  certifications    Certification[]
  awards             Award[]
  consultations      Consultancy[]
  patents            Patent[]
  books              Book[]
  projects           Project[]
  fdpPrograms        FDPProgram[]
  advisedBatches     Batch[]
  
  @@index([departmentId])
  @@index([employeeId])
  @@index([userId])
}

// ==================== STUDENT ====================

model Student {
  id                String    @id @default(cuid())
  registerNumber    String    @unique
  rollNumber        String?
  userId            String    @unique
  departmentId      String
  batchId           String?
  semester          Int?
  section           String?
  batch             String?
  cgpa              Float?
  admissionYear     Int?
  graduationYear    Int?
  photo             String?
  approvalStatus    ApprovalStatus @default(APPROVED)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  user              User      @relation(fields: [userId], references: [id])
  department        Department @relation(fields: [departmentId], references: [id])
  batchInfo         Batch?    @relation(fields: [batchId], references: [id])
  activities        StudentActivity[]
  achievements      StudentAchievement[]
  internships       Internship[]
  placements        Placement[]
  certifications    StudentCertification[]
  npCourses         NPCourse[]
  hackathons        HackathonParticipation[]
  startups          Startup[]
  
  @@index([departmentId])
  @@index([registerNumber])
  @@index([userId])
}

// ==================== ACTIVITY MODULES ====================

model Activity {
  id               String        @id @default(cuid())
  title            String
  type             ActivityType
  description      String?
  startDate        DateTime?
  endDate          DateTime?
  venue            String?
  organizer        String?
  participants     Int?
  outcome          String?
  status           ActivityStatus @default(PLANNED)
  departmentId     String
  conductedBy      String?
  attachments      String?
  reportUrl        String?
  approvalStatus   ApprovalStatus @default(PENDING)
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  
  department       Department     @relation(fields: [departmentId], references: [id])
  facultyActivities FacultyActivity[]
  studentActivities StudentActivity[]
  
  @@index([departmentId])
  @@index([type])
  @@index([status])
  @@index([approvalStatus])
}

enum ActivityType {
  EVENT
  WORKSHOP
  SEMINAR
  CONFERENCE
  GUEST_LECTURE
  FDP
  INDUSTRIAL_VISIT
  RESOURCE_PERSON
  EXTENSION_ACTIVITY
  INDUSTRY_COLLABORATION
  MOU_SIGNED
  OTHER
}

enum ActivityStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
  POSTPONED
}

model FacultyActivity {
  id          String   @id @default(cuid())
  facultyId   String
  activityId  String
  role        String?
  hoursSpent  Float?
  remarks     String?
  createdAt   DateTime @default(now())
  
  faculty     Faculty  @relation(fields: [facultyId], references: [id])
  activity    Activity @relation(fields: [activityId], references: [id])
  
  @@unique([facultyId, activityId])
}

model StudentActivity {
  id          String   @id @default(cuid())
  studentId   String
  activityId  String
  role        String?
  remarks     String?
  createdAt   DateTime @default(now())
  
  student     Student  @relation(fields: [studentId], references: [id])
  activity    Activity @relation(fields: [activityId], references: [id])
  
  @@unique([studentId, activityId])
}

// ==================== RESEARCH MODULES ====================

model Research {
  id               String         @id @default(cuid())
  title            String
  type             ResearchType
  description      String?
  authors          String?
  publication      String?
  publisher        String?
  doi              String?
  isbn             String?
  issn             String?
  volume           String?
  issue            String?
  pages            String?
  publishDate      DateTime?
  indexedIn        String?
  impactFactor     Float?
  citations        Int            @default(0)
  url              String?
  departmentId     String
  facultyId        String?
  status           ResearchStatus @default(PUBLISHED)
  approvalStatus   ApprovalStatus @default(PENDING)
  approvedBy       String?
  approvedAt       DateTime?
  attachments      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  
  department       Department            @relation(fields: [departmentId], references: [id])
  publications     ResearchPublication[]
  
  @@index([departmentId])
  @@index([type])
  @@index([status])
}

enum ResearchType {
  JOURNAL
  CONFERENCE
  PATENT
  BOOK
  BOOK_CHAPTER
  PROJECT
  CONSULTANCY
  RESEARCH_GRANT
}

enum ResearchStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  PUBLISHED
  REJECTED
  WITHDRAWN
}

model ResearchPublication {
  id          String   @id @default(cuid())
  researchId  String
  facultyId   String
  authorOrder Int?
  createdAt   DateTime @default(now())
  
  research    Research @relation(fields: [researchId], references: [id])
  faculty     Faculty  @relation(fields: [facultyId], references: [id])
  
  @@unique([researchId, facultyId])
}

// ==================== CERTIFICATION & AWARDS ====================

model Certification {
  id                String   @id @default(cuid())
  title             String
  issuer            String?
  certificateNumber String?
  issuedDate        DateTime?
  validUntil        DateTime?
  credentialUrl     String?
  facultyId         String
  attachments       String?
  approvalStatus    ApprovalStatus @default(PENDING)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  faculty           Faculty  @relation(fields: [facultyId], references: [id])
  
  @@index([facultyId])
}

model StudentCertification {
  id                String   @id @default(cuid())
  title             String
  issuer            String?
  certificateNumber String?
  issuedDate        DateTime?
  validUntil        DateTime?
  credentialUrl     String?
  studentId         String
  attachments       String?
  approvalStatus    ApprovalStatus @default(PENDING)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  student           Student  @relation(fields: [studentId], references: [id])
  
  @@index([studentId])
}

model Award {
  id           String   @id @default(cuid())
  title        String
  awardedBy    String?
  awardDate    DateTime?
  category     String?
  level        String?
  description  String?
  facultyId    String
  attachments  String?
  createdAt    DateTime @default(now())
  
  faculty      Faculty  @relation(fields: [facultyId], references: [id])
  
  @@index([facultyId])
}

model StudentAchievement {
  id            String          @id @default(cuid())
  title         String
  type          AchievementType
  description   String?
  achievedDate  DateTime?
  level         String?
  position      String?
  organizedBy   String?
  studentId     String
  attachments   String?
  approvalStatus ApprovalStatus @default(PENDING)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  student       Student          @relation(fields: [studentId], references: [id])
  
  @@index([studentId])
  @@index([type])
}

enum AchievementType {
  SPORTS
  CULTURAL
  TECHNICAL
  ACADEMIC
  EXTRA_CURRICULAR
  CO_CURRICULAR
  COMMUNITY_SERVICE
  PROJECT
  COMPETITION
  OTHER
}

// ==================== INTERNSHIP & PLACEMENT ====================

model Internship {
  id               String   @id @default(cuid())
  company          String
  location         String?
  domain           String?
  startDate        DateTime?
  endDate          DateTime?
  stipend          Float?
  offerLetter      Boolean  @default(false)
  completionCert   Boolean  @default(false)
  description      String?
  studentId        String
  supervisor       String?
  supervisorEmail  String?
  attachments      String?
  approvalStatus   ApprovalStatus @default(PENDING)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  student          Student  @relation(fields: [studentId], references: [id])
  
  @@index([studentId])
}

model Placement {
  id               String   @id @default(cuid())
  company          String
  location         String?
  designation      String?
  packageLPA       Float?
  offerDate        DateTime?
  joiningDate      DateTime?
  accepted         Boolean  @default(false)
  joined           Boolean  @default(false)
  description      String?
  studentId        String
  attachments      String?
  approvalStatus   ApprovalStatus @default(PENDING)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  student          Student  @relation(fields: [studentId], references: [id])
  
  @@index([studentId])
}

// ==================== NPTEL & ONLINE COURSES ====================

model NPCourse {
  id             String   @id @default(cuid())
  courseName     String
  courseId       String?
  platform       String?
  instructor     String?
  startDate      DateTime?
  endDate        DateTime?
  score          Float?
  grade          String?
  certificateUrl String?
  studentId      String
  attachments    String?
  approvalStatus ApprovalStatus @default(PENDING)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  student        Student  @relation(fields: [studentId], references: [id])
  
  @@index([studentId])
}

// ==================== HACKATHON & STARTUP ====================

model HackathonParticipation {
  id           String   @id @default(cuid())
  name         String
  organizer    String?
  level        String?
  startDate    DateTime?
  endDate      DateTime?
  position     String?
  projectTitle String?
  teamSize     Int?
  description  String?
  studentId    String
  attachments  String?
  approvalStatus ApprovalStatus @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
    
  student      Student  @relation(fields: [studentId], references: [id])
  
  @@index([studentId])
}

model Startup {
  id           String   @id @default(cuid())
  name         String
  domain       String?
  founderRole  String?
  foundedDate  DateTime?
  funding      Float?
  stage        String?
  description  String?
  website      String?
  studentId    String
  incubator    String?
  attachments  String?
  approvalStatus ApprovalStatus @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  student      Student  @relation(fields: [studentId], references: [id])
  
  @@index([studentId])
}

// ==================== PATENTS & BOOKS ====================

model Patent {
  id           String        @id @default(cuid())
  title        String
  patentNumber String?
  inventors    String?
  filingDate   DateTime?
  publishDate  DateTime?
  grantDate    DateTime?
  status       PatentStatus @default(FILED)
  country      String?
  category     String?
  facultyId    String
  attachments  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  
  faculty      Faculty  @relation(fields: [facultyId], references: [id])
  
  @@index([facultyId])
}

enum PatentStatus {
  FILED
  PUBLISHED
  GRANTED
  ABANDONED
  REJECTED
}

model Book {
  id           String   @id @default(cuid())
  title        String
  authors      String?
  publisher    String?
  isbn         String?
  edition      String?
  publishDate  DateTime?
  bookType     BookType @default(TEXTBOOK)
  category     String?
  facultyId    String
  attachments  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  faculty      Faculty  @relation(fields: [facultyId], references: [id])
  
  @@index([facultyId])
}

enum BookType {
  TEXTBOOK
  REFERENCE_BOOK
  EDITED_BOOK
  BOOK_CHAPTER
  MANUAL
}

// ==================== PROJECTS & CONSULTANCY ====================

model Project {
  id                   String        @id @default(cuid())
  title                String
  type                 ProjectType   @default(RESEARCH)
  description          String?
  principalInvestigator String?
  coInvestigators      String?
  fundingAgency        String?
  amount               Float?
  startDate            DateTime?
  endDate              DateTime?
  status               ProjectStatus @default(ONGOING)
  outcomes             String?
  facultyId            String
  attachments          String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  
  faculty              Faculty  @relation(fields: [facultyId], references: [id])
  
  @@index([facultyId])
  @@index([type])
  @@index([status])
}

enum ProjectType {
  RESEARCH
  CONSULTANCY
  SPONSORED
  INTERNALLY_FUNDED
  STUDENT_PROJECT
}

enum ProjectStatus {
  PROPOSED
  APPROVED
  ONGOING
  COMPLETED
  ON_HOLD
  TERMINATED
}

model Consultancy {
  id           String             @id @default(cuid())
  title        String
  client       String?
  amount       Float?
  startDate    DateTime?
  endDate      DateTime?
  status       ConsultancyStatus @default(ONGOING)
  description  String?
  facultyId    String
  attachments  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  
  faculty      Faculty  @relation(fields: [facultyId], references: [id])
  
  @@index([facultyId])
}

enum ConsultancyStatus {
  ONGOING
  COMPLETED
  CANCELLED
}

// ==================== FDP & TRAINING ====================

model FDPProgram {
  id             String   @id @default(cuid())
  title          String
  organizer      String?
  type           String?
  startDate      DateTime?
  endDate        DateTime?
  durationDays   Int?
  venue          String?
  level          String?
  topics         String?
  facultyId      String
  attachments    String?
  certificateUrl String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  faculty        Faculty  @relation(fields: [facultyId], references: [id])
  
  @@index([facultyId])
}

// ==================== APPROVAL WORKFLOW ====================

model Approval {
  id           String         @id @default(cuid())
  entityType   EntityType
  entityId     String
  requestedBy  String
  currentStage ApprovalStage @default(STAFF_REVIEW)
  status       ApprovalStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  comments     String?
  activityId   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  @@index([entityType, entityId])
  @@index([requestedBy])
  @@index([status])
  @@index([currentStage])
}

enum EntityType {
  ACTIVITY
  RESEARCH
  ACHIEVEMENT
  INTERNSHIP
  PLACEMENT
  CERTIFICATION
  NPTEL_COURSE
  HACKATHON
  STARTUP
  PATENT
  BOOK
  PROJECT
  CONSULTANCY
  FDP
  FACULTY_PROFILE
  STUDENT_PROFILE
}

enum ApprovalStage {
  STAFF_REVIEW
  HOD_REVIEW
  ADMIN_REVIEW
  APPROVED
  REJECTED
  NEEDS_REVISION
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVISION
  WITHDRAWN
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id          String           @id @default(cuid())
  title       String
  message     String
  type        NotificationType @default(INFO)
  userId      String
  isRead      Boolean          @default(false)
  actionUrl   String?
  relatedId   String?
  entityType  EntityType?
  createdAt   DateTime         @default(now())
  
  user        User             @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  APPROVAL_REQUIRED
  APPROVED
  REJECTED
  REMINDER
  DEADLINE
  SYSTEM
}

// ==================== FEEDBACK ====================

model Feedback {
  id          String   @id @default(cuid())
  category    String
  rating      Int
  comments    String?
  anonymous   Boolean  @default(false)
  userId      String
  response    String?
  respondedAt DateTime?
  respondedBy String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([category])
  @@index([rating])
}

// ==================== FEEDBACK ENGINE (ADVANCED) ====================

model FeedbackForm {
  id                String               @id @default(cuid())
  title             String
  description       String?
  targetAudience    String               @default("ALL") // 'ALL' | 'ROLE' | 'DEPARTMENT' | 'BATCH' | 'INDIVIDUAL' | 'MULTIPLE_USERS'
  targetRole        UserRole?
  departmentId      String?
  batchId           String?
  targetUserIds     String?              // JSON array string of user IDs
  startDate         DateTime             @default(now())
  endDate           DateTime
  isAnonymous       Boolean              @default(false)
  isMandatory       Boolean              @default(false)
  allowResubmission Boolean              @default(false)
  status            String               @default("PUBLISHED") // 'DRAFT' | 'PUBLISHED' | 'EXPIRED' | 'CLOSED'
  createdById       String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  createdBy         User                 @relation("FeedbackFormCreator", fields: [createdById], references: [id])
  department        Department?          @relation(fields: [departmentId], references: [id])
  batch             Batch?               @relation(fields: [batchId], references: [id])
  questions         FeedbackQuestion[]
  assignments       FeedbackAssignment[]
  responses         FeedbackResponse[]

  @@index([targetAudience])
  @@index([createdById])
  @@index([status])
}

model FeedbackQuestion {
  id          String           @id @default(cuid())
  formId      String
  form        FeedbackForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  prompt      String
  type        String           // 'NUMBER_RATING' | 'STAR_RATING' | 'TEXT' | 'LONG_TEXT' | 'YES_NO' | 'SINGLE_CHOICE' | 'MULTIPLE_CHOICE' | 'DROPDOWN' | 'CHECKBOX' | 'NUMBER_SCALE'
  isRequired  Boolean          @default(true)
  order       Int              @default(0)
  options     String?          // JSON array string for choices e.g. ["Option 1", "Option 2"]
  minScale    Int?             @default(1)
  maxScale    Int?             @default(5)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  answers     FeedbackAnswer[]

  @@index([formId])
  @@index([order])
}

model FeedbackAssignment {
  id          String       @id @default(cuid())
  formId      String
  form        FeedbackForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String       @default("PENDING") // 'PENDING' | 'COMPLETED' | 'EXPIRED'
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([formId, userId])
  @@index([userId])
  @@index([formId])
  @@index([status])
}

model FeedbackResponse {
  id          String           @id @default(cuid())
  formId      String
  form        FeedbackForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  isAnonymous Boolean          @default(false)
  submittedAt DateTime         @default(now())

  answers     FeedbackAnswer[]

  @@index([formId])
  @@index([userId])
}

model FeedbackAnswer {
  id          String           @id @default(cuid())
  responseId  String
  response    FeedbackResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId  String
  question    FeedbackQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  ratingValue Float?
  textValue   String?
  jsonValue   String?          // For multi-select / checkbox arrays
  createdAt   DateTime         @default(now())

  @@index([responseId])
  @@index([questionId])
}

// ==================== DOCUMENT MANAGEMENT ====================

model Document {
  id            String           @id @default(cuid())
  name          String
  originalName  String
  mimeType      String
  size          Int
  url           String
  uploadedBy    String
  category      DocumentCategory @default(OTHER)
  entityType    EntityType?
  entityId      String?
  version       Int             @default(1)
  isLatest      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  
  @@index([entityType, entityId])
  @@index([uploadedBy])
  @@index([category])
}

enum DocumentCategory {
  REPORT
  CERTIFICATE
  PUBLICATION
  PRESENTATION
  SPREADSHEET
  IMAGE
  VIDEO
  ARCHIVE
  TEMPLATE
  OTHER
}

// ==================== AUDIT LOGS ====================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String?
  entityId   String?
  oldValue   String?
  newValue   String?
  ipAddress  String?
  userAgent  String?
  createdAt DateTime @default(now())
  
  user       User     @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ==================== SETTINGS & CONFIGURATION ====================

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  category    String   @default("GENERAL")
  description String?
  updatedAt   DateTime @updatedAt
  
  @@index([key])
  @@index([category])
}

// ==================== BATCH MANAGEMENT ====================

model Batch {
  id              String     @id @default(cuid())
  name            String                    // e.g., "2024 Batch", "2025 Batch"
  year            Int                       // Admission year
  departmentId    String
  section         String?                   // e.g., "A", "B", "C"
  strength        Int?                       // Total students
  advisorId       String?                   // Faculty advisor/mentor
  description     String?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  
  department      Department @relation(fields: [departmentId], references: [id])
  advisor         Faculty?   @relation(fields: [advisorId], references: [id])
  students        Student[]
  feedbackForms   FeedbackForm[]
  
  @@index([departmentId])
  @@index([year])
  @@unique([name, departmentId])
}

// ==================== INSTITUTION INFO ====================

model Institution {
  id                  String   @id @default(cuid())
  name                String
  shortName           String?
  address             String?
  city                String?
  state               String?
  pincode             String?
  country             String   @default("India")
  phone               String?
  email               String?
  website             String?
  logo                String?
  establishedYear     Int?
  accreditation       String?
  accreditationGrade  String?
  affiliation         String?
  type                String?
  currentAcademicYear String?
  currentSemester     String?
  updatedAt           DateTime @updatedAt
}

// ==================== CMS / SUPER ADMIN CONFIGURATION ====================

model CmsConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  category    String   @default("GENERAL")
  description String?
  updatedAt   DateTime @updatedAt
  
  @@index([key])
  @@index([category])
}

model CmsPage {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  content     String?      // JSON or HTML content
  status      PageStatus   @default(DRAFT)
  template    String?      // Template name
  metaTitle   String?
  metaDescription String?
  createdBy   String
  updatedBy   String?
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  @@index([slug])
  @@index([status])
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model CmsMenu {
  id        String     @id @default(cuid())
  title     String
  url       String?
  parentId  String?
  order     Int        @default(0)
  icon      String?
  isVisible Boolean    @default(true)
  openInNewTab Boolean  @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  parent    CmsMenu?   @relation("MenuHierarchy", fields: [parentId], references: [id])
  children  CmsMenu[]  @relation("MenuHierarchy")
  
  @@index([parentId])
  @@index([order])
}

model CmsBanner {
  id          String       @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String
  linkUrl     String?
  position    BannerPosition @default(HOME_TOP)
  status      BannerStatus  @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  order       Int          @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  @@index([position])
  @@index([status])
}

enum BannerPosition {
  HOME_TOP
  HOME_MIDDLE
  HOME_BOTTOM
  LOGIN_PAGE
  DASHBOARD_TOP
}

enum BannerStatus {
  ACTIVE
  INACTIVE
  SCHEDULED
}

model CmsAnnouncement {
  id          String            @id @default(cuid())
  title       String
  content     String?
  type        AnnouncementType  @default(INFO)
  targetRoles String?           // JSON array of roles
  targetDepts String?           // JSON array of department IDs
  isPinned    Boolean           @default(false)
  status      AnnouncementStatus @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  createdBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  @@index([status])
  @@index([isPinned])
  @@index([startDate])
}

enum AnnouncementType {
  INFO
  WARNING
  SUCCESS
  URGENT
  EVENT
  HOLIDAY
  MAINTENANCE
}

enum AnnouncementStatus {
  ACTIVE
  EXPIRED
  SCHEDULED
  DRAFT
}

model AuditLogEntry {
  id         String   @id @default(cuid())
  userId     String?
  userName   String?
  action     String
  module     String
  details    String?  // JSON string with additional data
  ipAddress  String?
  userAgent  String?
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
}

model SystemBackup {
  id          String   @id @default(cuid())
  fileName    String
  filePath    String
  size        Int      // in bytes
  type        BackupType @default(FULL)
  status      BackupStatus @default(COMPLETED)
  createdBy   String?
  notes       String?
  createdAt   DateTime @default(now())
  
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

enum BackupType {
  FULL
  USERS
  DATA
  SETTINGS
  MEDIA
}

enum BackupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  RESTORED
}
