// IQAC Enterprise ERP Management System - Complete Database Schema (SQLite)
// Nehru Institute of Engineering and Technology (Autonomous)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== USER & AUTHENTICATION ====================

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  password           String
  name               String
  role               String     @default("STAFF")
  phone              String?
  avatar             String?
  isActive           Boolean    @default(true)
  status             String     @default("ACTIVE")
  mustChangePassword Boolean    @default(false)
  createdBy          String?
  createdByRole      String?
  createdById        String?
  departmentId       String?
  lastLogin          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  
  department    Department? @relation(fields: [departmentId], references: [id])
  faculty       Faculty?
  student       Student[]
  notifications Notification[]
  auditLogs     AuditLog[]
  feedbacks     Feedback[]
  createdFeedbackForms FeedbackForm[] @relation("FeedbackFormCreator")
  feedbackAssignments  FeedbackAssignment[]
  feedbackResponses    FeedbackResponse[]
  
  @@index([departmentId])
  @@index([role])
  @@index([email])
}

model Department {
  id              String   @id @default(cuid())
  name            String   @unique
  code            String   @unique
  description     String?
  vision          String?
  mission         String?
  peo             String?
  po              String?
  pso             String?
  logo            String?
  hodId           String?
  establishedYear Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  users           User[]
  faculty         Faculty[]
  students        Student[]
  batches         Batch[]
  activities      Activity[]
  research        Research[]
  feedbackForms   FeedbackForm[]
  
  @@index([code])
}

model Faculty {
  id                String    @id @default(cuid())
  employeeId        String    @unique
  name              String?
  email             String?
  phone             String?
  userId            String?   @unique
  departmentId      String
  designation       String?
  qualification     String?
  specialization    String?
  experience        Float?
  dateOfJoining     DateTime?
  researchArea      String?
  photo             String?
  isHOD             Boolean   @default(false)
  approvalStatus    String    @default("APPROVED")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  department        Department @relation(fields: [departmentId], references: [id])
  activities        FacultyActivity[]
  researchPublications ResearchPublication[]
  certifications    Certification[]
  awards             Award[]
  consultations      Consultancy[]
  patents            Patent[]
  books              Book[]
  projects           Project[]
  fdpPrograms        FDPProgram[]
  advisedBatches     Batch[]
  
  @@index([departmentId])
  @@index([employeeId])
  @@index([userId])
}

model Student {
  id                String    @id @default(cuid())
  registerNumber    String    @unique
  rollNumber        String?
  name              String?
  email             String?
  phone             String?
  userId            String?   @unique
  departmentId      String
  batchId           String?
  semester          Int?
  section           String?
  batch             String?
  cgpa              Float?
  admissionYear     Int?
  graduationYear    Int?
  photo             String?
  approvalStatus    String    @default("APPROVED")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  department        Department @relation(fields: [departmentId], references: [id])
  batchInfo         Batch?    @relation(fields: [batchId], references: [id])
  activities        StudentActivity[]
  achievements      StudentAchievement[]
  internships       Internship[]
  placements        Placement[]
  certifications    StudentCertification[]
  npCourses         NPCourse[]
  hackathons        HackathonParticipation[]
  startups          Startup[]
  
  @@index([departmentId])
  @@index([registerNumber])
  @@index([userId])
}

model Activity {
  id               String        @id @default(cuid())
  title            String
  type             String
  description      String?
  startDate        DateTime?
  endDate          DateTime?
  venue            String?
  organizer        String?
  participants     Int?
  outcome          String?
  status           String        @default("PLANNED")
  departmentId     String
  conductedBy      String?
  attachments      String?
  reportUrl        String?
  approvalStatus   String        @default("PENDING")
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  
  department       Department     @relation(fields: [departmentId], references: [id])
  facultyActivities FacultyActivity[]
  studentActivities StudentActivity[]
  
  @@index([departmentId])
  @@index([type])
  @@index([status])
  @@index([approvalStatus])
}

model FacultyActivity {
  id          String   @id @default(cuid())
  facultyId   String
  activityId  String
  role        String?
  hoursSpent  Float?
  remarks     String?
  createdAt   DateTime @default(now())
  
  faculty     Faculty  @relation(fields: [facultyId], references: [id])
  activity    Activity @relation(fields: [activityId], references: [id])
  
  @@unique([facultyId, activityId])
}

model StudentActivity {
  id          String   @id @default(cuid())
  studentId   String
  activityId  String
  role        String?
  remarks     String?
  createdAt   DateTime @default(now())
  
  student     Student  @relation(fields: [studentId], references: [id])
  activity    Activity @relation(fields: [activityId], references: [id])
  
  @@unique([studentId, activityId])
}

model Research {
  id               String         @id @default(cuid())
  title            String
  type             String
  description      String?
  authors          String?
  publication      String?
  publisher        String?
  doi              String?
  isbn             String?
  issn             String?
  volume           String?
  issue            String?
  pages            String?
  publishDate      DateTime?
  indexedIn        String?
  impactFactor     Float?
  citations        Int            @default(0)
  url              String?
  departmentId     String
  facultyId        String?
  status           String         @default("PUBLISHED")
  approvalStatus   String         @default("PENDING")
  approvedBy       String?
  approvedAt       DateTime?
  attachments      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  
  department       Department            @relation(fields: [departmentId], references: [id])
  publications     ResearchPublication[]
  
  @@index([departmentId])
  @@index([type])
  @@index([status])
}

model ResearchPublication {
  id          String   @id @default(cuid())
  researchId  String
  facultyId   String
  authorOrder Int?
  createdAt   DateTime @default(now())
  
  research    Research @relation(fields: [researchId], references: [id])
  faculty     Faculty  @relation(fields: [facultyId], references: [id])
  
  @@unique([researchId, facultyId])
}

model Certification {
  id                String   @id @default(cuid())
  title             String
  issuer            String?
  certificateNumber String?
  issuedDate        DateTime?
  validUntil        DateTime?
  credentialUrl     String?
  facultyId         String
  attachments       String?
  approvalStatus    String   @default("PENDING")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  faculty           Faculty  @relation(fields: [facultyId], references: [id])
  
  @@index([facultyId])
}

model StudentCertification {
  id                String   @id @default(cuid())
  title             String
  issuer            String?
  certificateNumber String?
  issuedDate        DateTime?
  validUntil        DateTime?
  credentialUrl     String?
  studentId         String
  attachments       String?
  approvalStatus    String   @default("PENDING")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  student           Student  @relation(fields: [studentId], references: [id])
  
  @@index([studentId])
}

model Award {
  id           String   @id @default(cuid())
  title        String
  awardedBy    String?
  awardDate    DateTime?
  category     String?
  level        String?
  description  String?
  facultyId    String
  attachments  String?
  createdAt    DateTime @default(now())
  
  faculty      Faculty  @relation(fields: [facultyId], references: [id])
  
  @@index([facultyId])
}

model StudentAchievement {
  id            String          @id @default(cuid())
  title         String
  type          String
  description   String?
  achievedDate  DateTime?
  level         String?
  position      String?
  organizedBy   String?
  studentId     String
  attachments   String?
  approvalStatus String         @default("PENDING")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  student       Student          @relation(fields: [studentId], references: [id])
  
  @@index([studentId])
  @@index([type])
}

model Internship {
  id               String   @id @default(cuid())
  company          String
  location         String?
  domain           String?
  startDate        DateTime?
  endDate          DateTime?
  stipend          Float?
  offerLetter      Boolean  @default(false)
  completionCert   Boolean  @default(false)
  description      String?
  studentId        String
  supervisor       String?
  supervisorEmail  String?
  attachments      String?
  approvalStatus   String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  student          Student  @relation(fields: [studentId], references: [id])
  
  @@index([studentId])
}

model Placement {
  id               String   @id @default(cuid())
  company          String
  location         String?
  designation      String?
  packageLPA       Float?
  offerDate        DateTime?
  joiningDate      DateTime?
  accepted         Boolean  @default(false)
  joined           Boolean  @default(false)
  description      String?
  studentId        String
  attachments      String?
  approvalStatus   String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  student          Student  @relation(fields: [studentId], references: [id])
  
  @@index([studentId])
}

model NPCourse {
  id             String   @id @default(cuid())
  courseName     String
  courseId       String?
  platform       String?
  instructor     String?
  startDate      DateTime?
  endDate        DateTime?
  score          Float?
  grade          String?
  certificateUrl String?
  studentId      String
  attachments    String?
  approvalStatus String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  student        Student  @relation(fields: [studentId], references: [id])
  
  @@index([studentId])
}

model HackathonParticipation {
  id           String   @id @default(cuid())
  name         String
  organizer    String?
  level        String?
  startDate    DateTime?
  endDate      DateTime?
  position     String?
  projectTitle String?
  teamSize     Int?
  description  String?
  studentId    String
  attachments  String?
  approvalStatus String @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
    
  student      Student  @relation(fields: [studentId], references: [id])
  
  @@index([studentId])
}

model Startup {
  id           String   @id @default(cuid())
  name         String
  domain       String?
  founderRole  String?
  foundedDate  DateTime?
  funding      Float?
  stage        String?
  description  String?
  website      String?
  studentId    String
  incubator    String?
  attachments  String?
  approvalStatus String @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  student      Student  @relation(fields: [studentId], references: [id])
  
  @@index([studentId])
}

model Patent {
  id           String        @id @default(cuid())
  title        String
  patentNumber String?
  inventors    String?
  filingDate   DateTime?
  publishDate  DateTime?
  grantDate    DateTime?
  status       String        @default("FILED")
  country      String?
  category     String?
  facultyId    String
  attachments  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  faculty      Faculty  @relation(fields: [facultyId], references: [id])
  
  @@index([facultyId])
}

model Book {
  id           String   @id @default(cuid())
  title        String
  authors      String?
  publisher    String?
  isbn         String?
  edition      String?
  publishDate  DateTime?
  bookType     String   @default("TEXTBOOK")
  category     String?
  facultyId    String
  attachments  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  faculty      Faculty  @relation(fields: [facultyId], references: [id])
  
  @@index([facultyId])
}

model Project {
  id                   String        @id @default(cuid())
  title                String
  type                 String        @default("RESEARCH")
  description          String?
  principalInvestigator String?
  coInvestigators      String?
  fundingAgency        String?
  amount               Float?
  startDate            DateTime?
  endDate              DateTime?
  status               String        @default("ONGOING")
  outcomes             String?
  facultyId            String
  attachments          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  
  faculty              Faculty  @relation(fields: [facultyId], references: [id])
  
  @@index([facultyId])
  @@index([type])
  @@index([status])
}

model Consultancy {
  id           String    @id @default(cuid())
  title        String
  client       String?
  amount       Float?
  startDate    DateTime?
  endDate      DateTime?
  status       String    @default("ONGOING")
  description  String?
  facultyId    String
  attachments  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  faculty      Faculty  @relation(fields: [facultyId], references: [id])
  
  @@index([facultyId])
}

model FDPProgram {
  id             String   @id @default(cuid())
  title          String
  organizer      String?
  type           String?
  startDate      DateTime?
  endDate        DateTime?
  durationDays   Int?
  venue          String?
  level          String?
  topics         String?
  facultyId      String
  attachments    String?
  certificateUrl String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  faculty        Faculty  @relation(fields: [facultyId], references: [id])
  
  @@index([facultyId])
}

model Approval {
  id           String        @id @default(cuid())
  entityType   String
  entityId     String
  requestedBy  String
  currentStage String        @default("STAFF_REVIEW")
  status       String        @default("PENDING")
  reviewedBy   String?
  reviewedAt   DateTime?
  comments     String?
  activityId   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  @@index([entityType, entityId])
  @@index([requestedBy])
  @@index([status])
  @@index([currentStage])
}

model Notification {
  id          String           @id @default(cuid())
  title       String
  message     String
  type        String           @default("INFO")
  userId      String
  isRead      Boolean          @default(false)
  actionUrl   String?
  relatedId   String?
  entityType  String?
  createdAt   DateTime         @default(now())
  
  user        User             @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Feedback {
  id          String   @id @default(cuid())
  category    String
  rating      Int
  comments    String?
  anonymous   Boolean  @default(false)
  userId      String
  response    String?
  respondedAt DateTime?
  respondedBy String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([category])
}

model Document {
  id            String   @id @default(cuid())
  name          String?
  originalName  String?
  mimeType      String?
  size          Int?
  url           String?
  uploadedBy    String?
  category      String?  @default("OTHER")
  entityType    String?
  entityId      String?
  version       Int?     @default(1)
  isLatest      Boolean? @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([uploadedBy])
  @@index([category])
  @@index([entityType, entityId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldValue   String?
  newValue   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  category    String?  @default("GENERAL")
  description String?
  updatedAt   DateTime @updatedAt
  
  @@index([key])
}

model Institution {
  id                   String   @id @default(cuid())
  name                 String
  shortName            String?
  address              String?
  city                 String?
  state                String?
  pincode              String?
  country              String?
  phone                String?
  email                String?
  website              String?
  logo                 String?
  establishedYear      Int?
  accreditation        String?
  accreditationGrade   String?
  affiliation          String?
  type                 String?
  currentAcademicYear  String?
  currentSemester      String?
  updatedAt            DateTime @updatedAt
}

model Batch {
  id            String    @id @default(cuid())
  name          String
  year          Int?
  departmentId  String
  section       String?
  strength      Int?
  advisorId     String?
  description   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  department    Department @relation(fields: [departmentId], references: [id])
  advisor       Faculty?   @relation(fields: [advisorId], references: [id])
  students      Student[]
  
  @@index([departmentId])
}

model CmsConfig {
  id           String   @id @default(cuid())
  key          String   @unique
  value        String
  category     String?
  description  String?
  updatedAt    DateTime @updatedAt
}

model CmsPage {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  content         String?
  status          String   @default("DRAFT")
  template        String?
  metaTitle       String?
  metaDescription String?
  createdBy       String?
  updatedBy       String?
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([status])
}

model CmsMenu {
  id           String    @id @default(cuid())
  title        String
  url          String?
  parentId     String?
  order        Int       @default(0)
  icon         String?
  isVisible    Boolean   @default(true)
  openInNewTab Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([parentId])
}

model CmsBanner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String
  linkUrl     String?
  position    String   @default("HOME_TOP")
  status      String   @default("ACTIVE")
  startDate   DateTime?
  endDate     DateTime?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([position])
  @@index([status])
}

model CmsAnnouncement {
  id          String    @id @default(cuid())
  title       String
  content     String?
  type        String    @default("INFO")
  targetRoles String?
  targetDepts String?
  isPinned    Boolean   @default(false)
  status      String    @default("ACTIVE")
  startDate   DateTime?
  endDate     DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

model AuditLogEntry {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String
  module    String?
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([action])
}

model SystemBackup {
  id        String   @id @default(cuid())
  fileName  String
  filePath  String
  size      Int
  type      String   @default("FULL")
  status    String   @default("COMPLETED")
  createdBy String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([status])
  @@index([type])
}

model FeedbackForm {
  id                 String               @id @default(cuid())
  title              String
  description        String?
  targetAudience     String               @default("ALL")
  targetRole         String?
  departmentId       String?
  batchId            String?
  targetUserIds      String?
  startDate          DateTime?
  endDate            DateTime?
  isAnonymous        Boolean              @default(false)
  isMandatory        Boolean              @default(false)
  allowResubmission  Boolean              @default(false)
  status             String               @default("ACTIVE")
  createdById        String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  creator            User                 @relation("FeedbackFormCreator", fields: [createdById], references: [id])
  department         Department?          @relation(fields: [departmentId], references: [id])
  questions          FeedbackQuestion[]
  assignments        FeedbackAssignment[]
  responses          FeedbackResponse[]

  @@index([createdById])
  @@index([departmentId])
}

model FeedbackQuestion {
  id         String           @id @default(cuid())
  formId     String
  prompt     String
  type       String           @default("RATING_1_5")
  isRequired Boolean          @default(true)
  order      Int              @default(0)
  options    String?
  minScale   Int?
  maxScale   Int?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  form       FeedbackForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers    FeedbackAnswer[]

  @@index([formId])
}

model FeedbackAssignment {
  id           String       @id @default(cuid())
  formId       String
  userId       String?
  status       String?      @default("PENDING")
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  form         FeedbackForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([userId])
}

model FeedbackResponse {
  id           String           @id @default(cuid())
  formId       String
  userId       String?
  isAnonymous  Boolean          @default(false)
  submittedAt  DateTime         @default(now())

  form         FeedbackForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers      FeedbackAnswer[]

  @@index([formId])
  @@index([userId])
}

model FeedbackAnswer {
  id          String           @id @default(cuid())
  responseId  String
  questionId  String
  ratingValue Float?
  textValue   String?
  jsonValue   String?
  createdAt   DateTime         @default(now())

  response    FeedbackResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question    FeedbackQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([questionId])
}
